# Privy (dashboard.privy.io)
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# x402 — where submission fees land (the deployed FrontierEscrow address; can be a plain EOA until deployed)
NEXT_PUBLIC_PAYTO_ADDRESS=
# x402 facilitator (default public testnet facilitator works for base-sepolia)
X402_FACILITATOR_URL=https://x402.org/facilitator

# Escrow (Base Sepolia)
ESCROW_ADDRESS=
DEPLOYER_PRIVATE_KEY=
BASE_SEPOLIA_RPC=https://sepolia.base.org

# Worker auth (any random string; worker must present it)
WORKER_SECRET=frontier-dev-secret
